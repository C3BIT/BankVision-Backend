NODE_ENV=production
PORT=5094

# Database (MariaDB)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRATION=8h

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# LiveKit / OpenVidu
LIVEKIT_URL=wss://your-livekit-domain.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_API_URL=          # Optional: internal URL for server-to-server calls (avoids DNS hairpin)
OPENVIDU_DOMAIN=

# MinIO Storage
MINIO_ENDPOINT=http://<video-infra-server-ip>:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=https://your-api-domain.com   # Base URL for recording download links
MINIO_EGRESS_ENDPOINT=http://<video-infra-server-ip>:9000  # IP reachable by egress container for S3 uploads

# Face Recognition
FACE_PROVIDER=opencv                            # opencv | aws | mxface
OPENCV_SERVICE_URL=http://<face-service-ip>:5097
OPENCV_THRESHOLD=0.4

# Frontend URLs
CUSTOMER_PANEL_URL=https://
MANAGER_PANEL_URL=https://
ADMIN_PANEL_URL=https://

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=https://customer.yourdomain.com,https://manager.yourdomain.com,https://admin.yourdomain.com

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_ID=
EMAIL_PASSWORD=

# SMS OTP (sms.net.bd)
SMS_API_KEY=
SMS_API_URL=https://api.sms.net.bd/sendsms

# ── MTB CBS Integration ────────────────────────────────────────────────────────
# Shared credentials & default base URL
# Set CBS_CORE_URL and all 13 API URLs default to it automatically.
# Override any individual API URL if MTB provides a different host/port for that API.
CBS_CORE_URL=http://<cbs-server-ip>:9090
CBS_CHANNEL_ID=101
CBS_USERNAME=
CBS_PASSWORD=

# Per-API URLs — each defaults to CBS_CORE_URL + path if left blank
# API 01 — getDetailAccountInfo
CBS_URL_DETAIL_ACCOUNT=
# API 02 — serExtensiveinfobymobileno
CBS_URL_EXTENSIVE_INFO=
# API 03 — serCusLinkeAccInfo
CBS_URL_LINKED_ACC=
# API 04 — getUserIdentity
CBS_URL_USER_IDENTITY=
# API 05 — sendEmail
CBS_EMAIL_URL=
# API 06 — sendSMS
CBS_SMS_URL=
# API 07 — getDebitCardEmailMobile
CBS_CARD_URL=
# API 08 — updateOMSCustomerEmailMobile
CBS_OMS_URL=
# API 09 — UpdateCustomer (MTB uses different port: 9085)
CBS_UPDATE_URL=http://<cbs-server-ip>:9085/MTBCBSMiddleware/cbs/api/v1/UpdateCustomer/updatecustomer
# API 10 — getCustomerPhoto
CBS_URL_CUSTOMER_PHOTO=
# API 11 — getCustomerCards
CBS_URL_CUSTOMER_CARDS=
# API 12 — getCustomerSignature
CBS_URL_CUSTOMER_SIGNATURE=
# API 13 — setAccountActive
CBS_URL_SET_ACCOUNT_ACTIVE=

# CBS Notifications — SMS
CBS_SMS_USERNAME=
CBS_SMS_PASSWORD=
CBS_SMS_CHANNEL_ID=101
CBS_SMS_EVENT=PIN

# CBS Notifications — Email
CBS_EMAIL_CHANNEL_ID=101
CBS_FROM_EMAIL=                                 # e.g. voc@mutualtrustbank.com
CBS_FROM_EMAIL_DISPLAY_NAME=                    # e.g. VOC
CBS_EMAIL_EVENT=OTP
CBS_EMAIL_SUBJECT=BankVision OTP Verification

# CBS UpdateCustomer auth & metadata
CBS_UPDATE_USERID=                              # Base64-encoded CBS user ID
CBS_UPDATE_PASSWORD=                            # Base64-encoded CBS password
CBS_INST_NUMBER=
CBS_BRANCH_NUMBER=
CBS_TELLER_NUMBER=
CBS_UUID_SOURCE=SDU
CBS_UUID_SEQ_NO=0001
CBS_FLAG4=Y
CBS_FLAG5=Y
CBS_DATAFIX_USER=
CBS_APPROVE_USER=
CBS_DEFAULT_PURPOSE=BankVision customer update
CBS_DEFAULT_BUGID=BV001

# CBS Account lookup filters
CBS_ACC_TYPE=A                                  # Account type for serCusLinkeAccInfo
CBS_ACC_STATE=O                                 # Account state (O = Open/Operative)
CBS_OMS_CHANNEL_ID=121                          # Channel ID for updateOMSCustomerEmailMobile

# Cookie Security
# COOKIE_SECURE=true        # Force secure cookies (auto-set in production)
# COOKIE_DOMAIN=            # Share cookies across subdomains e.g. .yourdomain.com
