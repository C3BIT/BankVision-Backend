NODE_ENV=production
PORT=5094

# ── Database (MariaDB) ────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION=8h

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── LiveKit / OpenVidu ────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-livekit-domain.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_API_URL=
OPENVIDU_DOMAIN=

# ── MinIO Storage ─────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://<video-infra-server-ip>:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=https://your-api-domain.com
MINIO_EGRESS_ENDPOINT=http://<video-infra-server-ip>:9000
MINIO_HOST=

# ── Face Recognition ──────────────────────────────────────────────────────────
# opencv | cbs | aws | mxface
# Use "cbs" when CBS getCustomerPhoto + getUserIdentity APIs are provisioned
FACE_PROVIDER=opencv
OPENCV_SERVICE_URL=http://<face-service-ip>:5097
OPENCV_THRESHOLD=0.4

# ── Frontend URLs ─────────────────────────────────────────────────────────────
CUSTOMER_PANEL_URL=https://
MANAGER_PANEL_URL=https://
ADMIN_PANEL_URL=https://

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://customer.yourdomain.com,https://manager.yourdomain.com,https://admin.yourdomain.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_ID=
EMAIL_PASSWORD=

# ── SMS OTP (sms.net.bd) ──────────────────────────────────────────────────────
SMS_API_KEY=
SMS_API_URL=https://api.sms.net.bd/sendsms

# ── MTB CBS Integration ───────────────────────────────────────────────────────
# Set CBS_CORE_URL — all 13 per-API URLs default to CBS_CORE_URL + path.
# Only set a per-API URL if that API lives on a different host/port.

# Shared base & credentials
CBS_CORE_URL=http://<cbs-server-ip>:9090
CBS_CHANNEL_ID=101
CBS_USERNAME=
CBS_PASSWORD=

# Per-API URLs (leave blank to derive from CBS_CORE_URL automatically)
CBS_URL_DETAIL_ACCOUNT=          # API 01 — getDetailAccountInfo
CBS_URL_EXTENSIVE_INFO=          # API 02 — serExtensiveinfobymobileno
CBS_URL_LINKED_ACC=              # API 03 — serCusLinkeAccInfo
CBS_URL_USER_IDENTITY=           # API 04 — getUserIdentity
CBS_EMAIL_URL=                   # API 05 — sendEmail
CBS_SMS_URL=                     # API 06 — sendSMS
CBS_CARD_URL=                    # API 07 — getDebitCardEmailMobile
CBS_OMS_URL=                     # API 08 — updateOMSCustomerEmailMobile
CBS_UPDATE_URL=http://<cbs-server-ip>:9085/MTBCBSMiddleware/cbs/api/v1/UpdateCustomer/updatecustomer  # API 09 — UpdateCustomer (different port)
CBS_URL_CUSTOMER_PHOTO=          # API 10 — getCustomerPhoto
CBS_URL_CUSTOMER_CARDS=          # API 11 — getCustomerCards
CBS_URL_CUSTOMER_SIGNATURE=      # API 12 — getCustomerSignature
CBS_URL_SET_ACCOUNT_ACTIVE=      # API 13 — setAccountActive

# SMS settings
CBS_SMS_USERNAME=
CBS_SMS_PASSWORD=
CBS_SMS_CHANNEL_ID=101
CBS_SMS_EVENT=PIN

# Email settings
CBS_EMAIL_CHANNEL_ID=101
CBS_FROM_EMAIL=
CBS_FROM_EMAIL_DISPLAY_NAME=
CBS_EMAIL_EVENT=OTP
CBS_EMAIL_SUBJECT=BankVision OTP Verification

# UpdateCustomer (API 09) auth & metadata
CBS_UPDATE_USERID=               # Base64-encoded userid from MTB
CBS_UPDATE_PASSWORD=             # Base64-encoded password from MTB
CBS_INST_NUMBER=
CBS_BRANCH_NUMBER=
CBS_TELLER_NUMBER=
CBS_UUID_SOURCE=SDU
CBS_UUID_SEQ_NO=0001
CBS_FLAG4=Y
CBS_FLAG5=Y
CBS_DATAFIX_USER=
CBS_APPROVE_USER=
CBS_DEFAULT_PURPOSE=BankVision customer update
CBS_DEFAULT_BUGID=BV001

# Account lookup filters
CBS_ACC_TYPE=A
CBS_ACC_STATE=O
CBS_OMS_CHANNEL_ID=121

# ── Cookie Security ───────────────────────────────────────────────────────────
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
